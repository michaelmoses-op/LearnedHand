# Copy to .env (make setup does this). Placeholders only; never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Runtime (non-owner role so RLS applies) and migrations (owner role)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev@localhost:5432/app_dev
MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:app_owner_dev@localhost:5432/app_dev
TEST_DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev@localhost:5432/app_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:app_owner_dev@localhost:5432/app_test
DB_POOL_SIZE=5

# Secure cookies need https; false for plain-http localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER=fake
# LLM_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

STORAGE_ROOT=./var/storage

# >= 32 chars. Generate for real deployments: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
MAX_UPLOAD_BYTES=104857600
