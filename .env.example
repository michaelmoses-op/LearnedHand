# Copy to .env (make setup does this). Placeholders only; never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Runtime (non-owner role so RLS applies) and migrations (owner role)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev@localhost:5432/app_dev
MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:app_owner_dev@localhost:5432/app_dev
TEST_DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev@localhost:5432/app_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:app_owner_dev@localhost:5432/app_test
DB_POOL_SIZE=5

# Secure cookies need https; false for plain-http localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=fake
LLM_MODEL=fake-chat
EMBEDDING_MODEL=fake-embed
EMBEDDING_DIM=1536
# --- Real provider (OpenAI). Nothing is billed until LLM_PROVIDER=openai and a key is set. ---
# LLM_PROVIDER=openai
# LLM_API_KEY=            # only needed when LLM_PROVIDER is not fake
# LLM_MODEL=              # answers
# LLM_INGEST_MODEL=       # optional cheaper model for prefixes/summaries (defaults to LLM_MODEL)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536      # must match the chunks.embedding column (1536); HNSW max is 2000
# LLM_DAILY_TOKEN_CAP=5000000   # per-user daily budget; 0 disables
# PRICE_INPUT_PER_MTOK=0        # USD per 1M tokens, for eval cost reporting only
# PRICE_OUTPUT_PER_MTOK=0

# none | fake | cross_encoder (cross_encoder needs: uv sync --extra rerank)
RERANKER=none

STORAGE_ROOT=./var/storage

# >= 32 chars. Generate for real deployments: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
MAX_UPLOAD_BYTES=262144000

# Retrieval routing and agentic gap-check loop (Phase 4)
ROUTING_ENABLED=true
RETRIEVAL_MAX_ITERATIONS=1
